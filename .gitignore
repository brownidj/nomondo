# BeneEde runtime data; keep data/restaurants.txt and documentation
/data/*.sqlite3
/data/restaurants.csv
/data/backups/
/data/logs/
/data/mobile_connection.json
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.log

# Flutter has additional rules in flutter_app/.gitignore and platform folders
.dart_tool/
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies

